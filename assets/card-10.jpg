vicon_url\":\"/images/favicon.png\",\"contact_email\":\"contact@alfurqan.academy\",\"contact_phone\":\"+44 20 4577 1227\",\"contact_hours\":\"24x7 - We're always here for you.\",\"contact_support\":\"We serve students worldwide.\",\"social_facebook\":\"https://www.facebook.com/AlFurqanHub\",\"social_instagram\":\"https://www.instagram.com/alfurqan.academy4u/\",\"social_youtube\":\"https://www.youtube.com/@AlFurqanHub\",\"social_whatsapp\":\"https://api.whatsapp.com/send?phone=442045771227\u0026text=Assalamu%20Alaikum%20wa%20Rahmatullahi%20wa%20Barakatuh%0A%0AI%20am%20interested%20in%20learning%20Online%20Qur%27an,%20Arabic%20language,%20Islamic%20study.%0APlease%20reach%20out%20to%20me.\",\"social_x\":\"https://x.com/alfurqan\",\"footer_address\":\"128, City Road, London, EC1V 2NX, United Kingdom\",\"footer_copyright\":\"© 2026 Al Furqan Academy LTD. All rights reserved.\",\"app_play_store\":\"https://play.google.com/store\",\"app_app_store\":\"https://apps.apple.com/us\",\"cta_title_line1\":\"Learn with Purpose.\",\"cta_title_line2\":\"Grow with Al Furqan.\",\"cta_description\":\"Quality Islamic education for all ages, from the comfort of your home.\",\"cta_btn_primary_text\":\"Start Your Journey Today\",\"cta_btn_primary_link\":\"/register\",\"cta_btn_secondary_text\":\"Book Your Free Trial Class\",\"cta_btn_secondary_link\":\"/register\",\"cta_image_url\":\"/images/cta-student.png\",\"cta_image_alt\":\"A student holding the Quran\",\"announcement_enabled\":false,\"announcement_text\":\"Quran Classes are open! Book your free trial today.\",\"announcement_link\":\"/register\",\"header_phone_enabled\":true,\"header_phone_text\":\"+44 20 4577 1227\",\"header_phone_url\":\"tel:+442045771227\",\"header_cta_enabled\":true,\"header_cta_text\":\"Book Free Evaluation\",\"header_cta_url\":\"/register\",\"cnt_eyebrow\":\"Contact us\",\"cnt_title\":\"We're Here to Help You\",\"cnt_lead\":\"Have a question or need assistance? Our team is happy to support you on your learning journey.\",\"cnt_image\":\"/images/contact/hero.png\",\"cnt_image_alt\":\"An Al Furqan Academy adviser on a video call\",\"cnt_details_title\":\"Get in Touch\",\"cnt_details_lead\":\"We'd love to hear from you.\",\"cnt_form_title\":\"Send us a message\",\"cnt_form_lead\":\"We reply to every enquiry, usually within one working day.\",\"cnt_label_email\":\"Email Us\",\"cnt_label_phone\":\"Call / WhatsApp\",\"cnt_label_hours\":\"Working Hours\",\"cnt_label_support\":\"Worldwide Support\",\"hero_tagline\":\"KNOWLEDGE • CHARACTER • PURPOSE \",\"hero_title_line1\":\"Learn Quran Online\",\"hero_title_line2\":\"Master Arabic\",\"hero_title_line3\":\"and Deepen Your\",\"hero_title_line4\":\"Understanding of Islam\",\"hero_subtitle\":\"Learn from Qualified Teachers - From Anywhere in the World\",\"hero_btn_text\":\"Book Free Trial\",\"hero_btn_link\":\"/register\",\"hero_image_left\":\"/images/home/hero-left.png\",\"hero_image_right\":\"/images/home/hero-right.png\",\"hero_badge1_title\":\"For All Ages.\",\"hero_badge1_desc\":\"Children • Teens • Adults\",\"hero_badge2_title\":\"Flexible Learning\\nBeginner to Advanced\",\"ms_kicker\":\"OUR JOURNEY SO FAR\",\"ms_title\":\"Growing Globally, Teaching Personally\",\"ms_lead\":\"From individual learners to families worldwide, our mission is to make quality Islamic education accessible from anywhere.\",\"ms_stat1_value\":\"261+\",\"ms_stat1_label\":\"Students\",\"ms_stat1_sub\":\"Learning with us worldwide\",\"ms_stat2_value\":\"88+\",\"ms_stat2_label\":\"Countries\",\"ms_stat2_sub\":\"Global reach and growing\",\"ms_stat3_value\":\"32+\",\"ms_stat3_label\":\"Qualified Teachers\",\"ms_stat3_sub\":\"Experts in Quran, Arabic \u0026 Islamic Studies\",\"ms_stat4_value\":\"99%\",\"ms_stat4_label\":\"Student Satisfaction\",\"ms_stat4_sub\":\"Trusted by Learners \u0026 Students\",\"ms_badge_text\":\"Students learning\\nfrom more than\",\"ms_badge_highlight\":\"88 countries\",\"courses_kicker\":\"Our Courses\",\"courses_title\":\"Courses Designed for Every Learner\",\"courses_lead\":\"\u003cp class=\\\"MsoNormal\\\"\u003e\u003cspan lang=\\\"EN-US\\\"\u003eExplore our online Quran, Arabic, and\\nIslamic Studies courses for all ages and levels\u003co:p\u003e\u003c/o:p\u003e\u003c/span\u003e\u003c/p\u003e\",\"courses_feat1_title\":\"Expert Teachers\",\"courses_feat1_desc\":\"Learn from qualified and experienced instructors.\",\"courses_feat2_title\":\"Trusted \u0026 Authentic\",\"courses_feat2_desc\":\"Courses designed according to authentic Islamic teachings.\",\"courses_feat3_title\":\"Flexible Learning\",\"courses_feat3_desc\":\"Learn anytime, anywhere at your own pace.\",\"courses_feat4_title\":\"For All Ages\",\"courses_feat4_desc\":\"Kids, teens, and adults- we have something for everyone\",\"wcu_kicker\":\"Why choose Al Furqan\",\"wcu_title_line1\":\"Why Al Furqan\",\"wcu_title_accent\":\"Right\",\"wcu_title_line2\":\"Choice for You\",\"wcu_lead\":\"We provide authentic, engaging, and flexible Islamic education to help you and your family grow in faith, knowledge, and character.\",\"wcu_btn_text\":\"Start Your Learning Journey\",\"wcu_btn_link\":\"/register\",\"wcu_promise1\":\"Learn from Qualified \u0026 Experienced Teachers\",\"wcu_promise2\":\"Personalized Learning for All Ages \u0026 Levels\",\"wcu_promise3\":\"Flexible Schedules - Learn from Anywhere\",\"wcu_promise4\":\"Trusted by Learners \u0026 Families Worldwide\",\"wcu_pillar1_title\":\"Empowerment\",\"wcu_pillar1_body\":\"We empower you with the knowledge and confidence to understand Islam and apply it in your daily life.\",\"wcu_pillar2_title\":\"Legacy\",\"wcu_pillar2_body\":\"Your learning today becomes a lasting legacy for you and your future generations.\",\"wcu_pillar3_title\":\"Inspiration\",\"wcu_pillar3_body\":\"Learn in a positive environment that motivates you to grow, improve, and strive for excellence.\",\"wcu_pillar4_title\":\"Innovation\",\"wcu_pillar4_body\":\"We use modern technology and proven teaching methods to make learning engaging and effective.\",\"wcu_badge1_title\":\"100% Authentic\",\"wcu_badge1_body\":\"Qur'an and Islamic education based on authentic sources.\",\"wcu_badge2_title\":\"Expert Teachers\",\"wcu_badge2_body\":\"Qualified, experienced, and passionate about teaching.\",\"wcu_badge3_title\":\"Safe \u0026 Secure\",\"wcu_badge3_body\":\"A safe learning environment for kids and adults.\",\"wcu_badge4_title\":\"Global Community\",\"wcu_badge4_body\":\"Join students from 88+ countries worldwide.\",\"hiw_kicker\":\"A SIMPLE JOURNEY TO A BRIGHTER TOMORROW\",\"hiw_title\":\"How Our Classes Work\",\"hiw_subtitle\":\"Simple Steps. Lasting Impact.\",\"hiw_lead\":\"We make Quran and Arabic learning easy, effective, and enjoyable through a personalized one-to-one learning experience.\",\"hiw_step1_title\":\"Book Free Trial\",\"hiw_step1_body\":\"Choose a convenient time and book your free trial class in minutes.\",\"hiw_step2_title\":\"Meet Your Teacher\",\"hiw_step2_body\":\"Get matched with a qualified teacher who understands your goals.\",\"hiw_step3_title\":\"Attend Live Classes\",\"hiw_step3_body\":\"Enjoy personalized one-to-one lessons from the comfort of your home.\",\"hiw_step4_title\":\"Track Your Progress\",\"hiw_step4_body\":\"Track your progress with regular feedback and assessments.\",\"ratings_kicker\":\"TRUSTED BY PARENTS\",\"ratings_title_line1\":\"Highly Rated.\",\"ratings_title_accent\":\"Trusted\",\"ratings_title_line2\":\"Worldwide.\",\"ratings_lead\":\"We're proud to be consistently rated highly by our students and parents across leading review platforms.\",\"ratings_p1_score\":\"4.8\",\"ratings_p1_stars\":4,\"ratings_p2_score\":\"5.0\",\"ratings_p2_stars\":5,\"ratings_p3_score\":\"4.8\",\"ratings_p3_stars\":4,\"prog_title_line1\":\"Learning for\",\"prog_title_accent\":\"Every Age\",\"prog_lead\":\"Whether you’re a parent looking for the best start for your child or an adult seeking to grow in faith, we have the right program for you.\",\"prog_c1_title\":\"Kids Program\",\"prog_c1_badge\":\"Ages 4-12\",\"prog_c1_image\":\"/images/home/age-kids.png\",\"prog_c1_body\":\"Fun, engaging and interactive classes designed to build a strong foundation in Islam.\",\"prog_c1_motto\":\"Learn | Explore | Grow\",\"prog_c2_title\":\"Teen Program\",\"prog_c2_badge\":\"Ages 13-18\",\"prog_c2_image\":\"/images/home/age-teen.png\",\"prog_c2_body\":\"Inspire, educate and empower teens to strengthen their faith and character in today's world.\",\"prog_c2_motto\":\"Learn | Understand | Grow\",\"prog_c3_title\":\"Adult Program\",\"prog_c3_badge\":\"18+\",\"prog_c3_image\":\"/images/home/age-adult.png\",\"prog_c3_body\":\"Deepen your knowledge, reconnect with your faith and grow spiritually at your own pace.\",\"prog_c3_motto\":\"Learn | Reflect | Grow\",\"prog_c4_title\":\"Family Program\",\"prog_c4_badge\":\"All Ages\",\"prog_c4_image\":\"/images/home/age-family.png\",\"prog_c4_body\":\"Deepen your knowledge, reconnect with your faith and grow spiritually at your own pace.\",\"prog_c4_motto\":\"Learn Together | Grow Together\",\"oqc_top_badge\":\"Trusted by Parents. Loved by Students.\",\"oqc_title_line1\":\"Online Quran\",\"oqc_title_accent\":\"Classes\",\"oqc_sub_part1\":\"Learn with Faith.\",\"oqc_sub_part2\":\"Grow with Knowledge.\",\"oqc_sub_part3\":\"Excel for Life.\",\"oqc_lead\":\"Personalized online Quran learning for kids, teens and adults with expert teachers and flexible schedules.\",\"oqc_image_url\":\"https://res.cloudinary.com/duednw9v/image/upload/v1791200637/alfurqan/home/1791200636828_9c07b59fc606.webp\",\"oqc_f1_title\":\"Expert Online Quran Classes\",\"oqc_f1_body\":\"Learn Quran with Tajweed, Qira'at, and Tafseer from highly qualified teachers.\",\"oqc_f1_more\":\"Every lesson is one-to-one, so the pace and focus follow the student rather than a fixed syllabus.\",\"oqc_f2_title\":\"Flexible Learning for Every Student\",\"oqc_f2_body\":\"Choose your schedule and learn at your own pace from the comfort of your home.\",\"oqc_f2_more\":\"Reschedule when life gets busy - your teacher keeps a record of where you left off.\",\"oqc_f3_title\":\"Master Tajweed and Quran Memorization\",\"oqc_f3_body\":\"Build strong recitation skills and memorize the Quran step by step.\",\"oqc_f3_more\":\"Structured revision cycles make sure what you memorise this month is still solid next year.\",\"oqc_f4_title\":\"Learn Quranic Arabic with Qualified Teachers\",\"oqc_f4_body\":\"Understand the meanings and vocabulary of the Quran and develop a deeper understanding of what you recite.\",\"oqc_f4_more\":\"Start with vocabulary you already meet in salah, then build towards reading unaided.\",\"oqc_btn_text\":\"Join Now \u0026 Start Your Quran Journey\",\"oqc_btn_link\":\"/register\",\"tch_kicker\":\"OUR TEACHERS\",\"tch_title_line1\":\"Qualified Teachers\",\"tch_title_line2\":\"Guiding Every Step of Your Learning Journey\",\"tch_lead\":\"Our team consists of qualified and passionate educators who are dedicated to helping students connect with the Quran and build strong Islamic knowledge in a supportive and engaging environment.\",\"tch_q_title_line1\":\"Teachers You\",\"tch_q_title_line2\":\"Can Trust\",\"tch_q_body\":\"Our teachers are carefully selected for their knowledge, teaching experience, communication skills, and commitment to student success.\",\"tch_q_motto\":\"Dedicated to Excellence\",\"tch_std1_title\":\"Qualified \u0026 Certified\",\"tch_std1_body\":\"Our teachers are certified in their fields with strong academic backgrounds.\",\"tch_std2_title\":\"Passionate \u0026 Caring\",\"tch_std2_body\":\"We choose teachers who truly care about students' growth and success.\",\"tch_std3_title\":\"Trained \u0026 Evaluated\",\"tch_std3_body\":\"Continuous training and evaluation ensure the best learning experience.\",\"tch_std4_title\":\"Global Standards\",\"tch_std4_body\":\"We follow international teaching standards to deliver quality education.\",\"cip_title_line1\":\"Common\",\"cip_title_line2\":\"Islamic Practices\",\"cip_lead\":\"When Muslims read, understand, memorize, and live by the Quran's morals, the Ummah rises with knowledge, faith, and purpose.\",\"cip_p1_title1\":\"Reading / Reciting the Quran\",\"cip_p1_title2\":\"on daily basis\",\"cip_p1_value\":30,\"cip_p2_title1\":\"Understanding the Quran\",\"cip_p2_title2\":\"(know Arabic or Study)\",\"cip_p2_value\":20,\"cip_p3_title1\":\"Memorizing the Quran\",\"cip_p3_title2\":\"(some portions of the Quran)\",\"cip_p3_value\":70,\"cip_p4_title1\":\"Following Islamic Morals /\",\"cip_p4_title2\":\"Sunnah in daily life\",\"cip_p4_value\":60,\"cip_citation\":\"Red: REW Research Center - \\\"The World's Muslims: Religion, Politics and Society\\\" (2017)\",\"tst_eyebrow\":\"TESTIMONIALS\",\"tst_title\":\"Trusted by Students. Loved by Families.\",\"tst_title_accent\":\"\",\"tst_lead\":\"See what our students and parents have to say about their journey with Al Furqan Academy.\",\"tst_rating_val\":\"4.9/5\",\"tst_rating_cnt\":\"Trusted by Families Worldwide\",\"tst_stat1_val\":\"261+\",\"tst_stat1_lbl\":\"Happy Students\",\"tst_stat2_val\":\"4.9/5\",\"tst_stat2_lbl\":\"Average Rating\",\"tst_stat3_val\":\"88+\",\"tst_stat3_lbl\":\"Countries Reached\",\"tst_stat4_val\":\"99%\",\"tst_stat4_lbl\":\"Parent Satisfaction\",\"blg_kicker\":\"AL FURQAN ACADEMY\",\"blg_title_line1\":\"Explore Our Latest Insights\",\"blg_title_line2\":\"from Al Furqan Academy\",\"blg_lead\":\"Stay updated with our latest articles on Islamic education, personal growth, and student development.\",\"faq_badge\":\"FAQS\",\"faq_title_line1\":\"Frequently\",\"faq_title_accent\":\"Asked Questions\",\"faq_lead\":\"Find answers to common questions about our classes, teachers, and the learning experience.\",\"faq_support_title\":\"Still have questions?\",\"faq_support_sub\":\"We're here to help you!\",\"faq_support_btn_text\":\"Contact Support\",\"faq_support_note\":\"We typically reply within a few minutes.\",\"faq_support_t1\":\"Quick Response\",\"faq_support_t2\":\"Reliable Support\",\"faq_support_t3\":\"We Care\",\"faq_q1\":\"What courses do you offer?\",\"faq_a1\":\"We offer online Quran classes, Arabic language courses, and Islamic Studies for kids, teens, adults, and families.\",\"faq_q2\":\"Do you offer a free trial class?\",\"faq_a2\":\"Yes. You can book a free trial class to experience our teaching approach, meet a teacher, and understand which program is suitable for you.\",\"faq_q3\":\"How long is each class?\",\"faq_a3\":\"Classes are available in 30-minute and 60-minute sessions, depending on the student's age, course, and selected program.\",\"faq_q4\":\"Are female teachers available?\",\"faq_a4\":\"Yes. Female teachers are available for students who prefer to learn with a female teacher, subject to availability and scheduling.\",\"faq_q5\":\"Can I choose my class schedule?\",\"faq_a5\":\"Yes. We offer flexible scheduling options so students can choose class times that fit their daily routine and availability.\",\"faq_q6\":\"What platform do you use for online classes?\",\"faq_a6\":\"Classes are conducted live through Microsoft Teams or Zoom, providing a secure and convenient environment for interactive lessons, communication, and learning.\",\"abt_hero_kicker\":\"ABOUT Al Furqan Academy\",\"abt_hero_title1\":\"Knowledge Today.\",\"abt_hero_title2\":\"Better Tomorrow.\",\"abt_hero_lead\":\"At Al Furqan Academy, we provide meaningful Islamic education that helps students of all ages strengthen their connection with the Quran, learn Arabic, and understand Islam in a practical and engaging way.\",\"abt_purpose_eyebrow\":\"Our Purpose\",\"abt_purpose_title\":\"Our Mission \u0026 Vision\",\"abt_purpose_lead\":\"Al Furqan Academy is committed to providing authentic Islamic education that nurtures hearts, builds character, and transforms lives.\",\"abt_mission_title\":\"To Make Authentic Islamic Education Accessible Worldwide\",\"abt_mission_lead\":\"We provide high-quality online Quran and Islamic education through qualified teachers, personalized learning, and flexible scheduling.\",\"abt_vision_title\":\"Building a Generation Connected to the Quran \u0026 Sunnah\",\"abt_vision_lead\":\"To be a global leader in online Islamic education, recognized for excellence, innovation, and positive spiritual impact.\",\"abt_hero_image_url\":\"/images/home/quran-student.png\",\"abt_val1_title\":\"Quality Education\",\"abt_val1_body\":\"We focus on providing high-quality Quran, Arabic, and Islamic studies with proven teaching methods.\",\"abt_val2_title\":\"Student Focused\",\"abt_val2_body\":\"Every student receives personal attention and guidance to help them achieve their goals.\",\"abt_val3_title\":\"Modern \u0026 Engaging\",\"abt_val3_body\":\"Our interactive classes and modern tools make learning effective, enjoyable, and inspiring.\",\"abt_val4_title\":\"Faith \u0026 Values\",\"abt_val4_body\":\"We nurture strong Islamic values and character along with academic growth in every learner.\",\"abt_mission_eyebrow\":\"OUR MISSION\",\"abt_mission_image_url\":\"/images/about/mission.svg\",\"abt_mission_lead2\":\"Our mission is to help every student grow in knowledge, strengthen their faith, and become a better version of themselves.\",\"abt_vision_eyebrow\":\"OUR VISION\",\"abt_vision_image_url\":\"/images/about/vision.png\",\"abt_vision_lead2\":\"Our goal is to inspire a lifelong journey of learning the Quran, understanding Islam, and serving the Ummah.\",\"abt_pil1_title\":\"KNOWLEDGE\",\"abt_pil1_body\":\"Providing authentic knowledge based on the Quran and Sunnah with clarity and understanding.\",\"abt_pil1_image_url\":\"/images/about/pillar-knowledge.svg\",\"abt_pil2_title\":\"CHARACTER\",\"abt_pil2_body\":\"Developing strong Islamic values, good manners, discipline, and a sincere connection with Allah.\",\"abt_pil2_image_url\":\"/images/about/pillar-character.svg\",\"abt_pil3_title\":\"EXCELLENCE\",\"abt_pil3_body\":\"Delivering education with professionalism, consistency, and a commitment to excellence.\",\"abt_pil3_image_url\":\"/images/about/pillar-excellence.svg\",\"abt_cv_eyebrow\":\"Our Core Values\",\"abt_cv_title\":\"What Makes Al Furqan Academy Different?\",\"abt_cv_lead\":\"We focus on holistic Islamic education that develops strong connection with the Quran, builds character, and prepares students for a purposeful life.\",\"abt_cv_c1_title\":\"Authentic Education\",\"abt_cv_c1_body\":\"Our curriculum is based on the Quran and Sunnah with the guidance of qualified and experienced teachers.\",\"abt_cv_c1_img\":\"\",\"abt_cv_c2_title\":\"Student Centered\",\"abt_cv_c2_body\":\"Personalized one-to-one classes that focus on each student's goals, level, and learning style.\",\"abt_cv_c2_img\":\"\",\"abt_cv_c3_title\":\"Global Impact\",\"abt_cv_c3_body\":\"We are proud to serve students and families in more than 80 countries around the world.\",\"abt_cv_c3_img\":\"\",\"abt_cv_st1_lbl\":\"Trust \u0026 Transparency\",\"abt_cv_st1_img\":\"\",\"abt_cv_st2_lbl\":\"Care \u0026 Compassion\",\"abt_cv_st2_img\":\"\",\"abt_cv_st3_lbl\":\"Consistency \u0026 Discipline\",\"abt_cv_st3_img\":\"\",\"abt_cv_st4_lbl\":\"Growth \u0026 Excellence\",\"abt_cv_st4_img\":\"\",\"abt_imp_eyebrow\":\"TRUSTED BY FAMILIES WORLDWIDE\",\"abt_imp_title\":\"Our Global Impact\",\"abt_imp_lead\":\"Al Furqan Academy is honored to be part of thousands of learning journeys across the world.\",\"abt_stat1_val\":\"235+\",\"abt_stat1_lbl\":\"Students\",\"abt_stat1_sub\":\"From around the world\",\"abt_stat2_val\":\"80+\",\"abt_stat2_lbl\":\"Countries\",\"abt_stat2_sub\":\"Global reach and growing\",\"abt_stat3_val\":\"30+\",\"abt_stat3_lbl\":\"Qualified Teachers\",\"abt_stat3_sub\":\"Experts in Quran \u0026 Islamic Studies\",\"abt_stat4_val\":\"99%\",\"abt_stat4_lbl\":\"Student Satisfaction\",\"abt_stat4_sub\":\"Trusted by parents \u0026 students\",\"abt_wfc_eyebrow\":\"Why families choose us\",\"abt_wfc_title\":\"Why Families Choose Al Furqan Academy\",\"abt_wfc_lead\":\"We make Quran and Islamic education simple, effective, and accessible for every Muslim family, everywhere.\",\"abt_wfc1_title\":\"One-to-One Classes\",\"abt_wfc1_body\":\"Personalized attention to help students learn better and faster.\",\"abt_wfc1_img\":\"\",\"abt_wfc2_title\":\"Qualified Teachers\",\"abt_wfc2_body\":\"Experienced, certified, and passionate Quran and Arabic teachers.\",\"abt_wfc2_img\":\"\",\"abt_wfc3_title\":\"Flexible Scheduling\",\"abt_wfc3_body\":\"Choose class times that fit your routine, not the other way around.\",\"abt_wfc3_img\":\"\",\"abt_wfc4_title\":\"Learn from Anywhere\",\"abt_wfc4_body\":\"Join live online classes from the comfort of your home.\",\"abt_wfc4_img\":\"\",\"abt_wfc5_title\":\"Progress Tracking\",\"abt_wfc5_body\":\"Regular feedback and reports to track your learning journey.\",\"abt_wfc5_img\":\"\",\"abt_wfc6_title\":\"Parent Involvement\",\"abt_wfc6_body\":\"Stay updated with your child's progress and achievements.\",\"abt_wfc6_img\":\"\",\"abt_wfc7_title\":\"Safe \u0026 Child-Friendly\",\"abt_wfc7_body\":\"A secure, respectful, and encouraging environment for every student.\",\"abt_wfc7_img\":\"\",\"abt_wfc8_title\":\"Wide Range of Courses\",\"abt_wfc8_body\":\"From Quran reading to Hifz, Arabic, and Islamic Studies for all ages.\",\"abt_wfc8_img\":\"\",\"abt_cwo_eyebrow\":\"Our Courses\",\"abt_cwo_title\":\"Courses We Offer\",\"abt_cwo_lead\":\"A wide range of Quran, Arabic, and Islamic studies courses designed for children, teens, and adults.\",\"abt_cwo_cta_title\":\"Start Your Learning Journey Today\",\"abt_cwo_cta_lead\":\"Join thousands of students worldwide and learn with qualified teachers.\",\"abt_cwo_btn1_text\":\"Book Free Trial\",\"abt_cwo_btn2_text\":\"View All Courses\",\"abt_tp_eyebrow\":\"OUR TEACHING PROCESS\",\"abt_tp_title\":\"How We Teach\",\"abt_tp_lead\":\"A simple, effective, and student-focused approach to help every learner succeed.\",\"abt_tp_s1_title\":\"Assessment\",\"abt_tp_s1_body\":\"We assess the student's level to understand their needs.\",\"abt_tp_s1_img\":\"\",\"abt_tp_s2_title\":\"Personalized Plan\",\"abt_tp_s2_body\":\"We create a customized learning plan tailored to each student.\",\"abt_tp_s2_img\":\"\",\"abt_tp_s3_title\":\"Live Classes\",\"abt_tp_s3_body\":\"One-to-one interactive classes with qualified teachers.\",\"abt_tp_s3_img\":\"\",\"abt_tp_s4_title\":\"Progress Tracking\",\"abt_tp_s4_body\":\"Regular feedback and reports to track improvement.\",\"abt_tp_s4_img\":\"\",\"abt_tp_s5_title\":\"Achievement\",\"abt_tp_s5_body\":\"Building confidence and helping students reach their goals.\",\"abt_tp_s5_img\":\"\",\"abt_tq_eyebrow\":\"OUR QUALIFICATIONS\",\"abt_tq_title\":\"Qualified to Teach. Committed to Excellence.\",\"abt_tq_lead\":\"Our teachers are highly qualified, experienced, and dedicated to providing the best Islamic education.\",\"abt_tq1_title\":\"Certified Teachers\",\"abt_tq1_body\":\"All teachers are certified in Quran, Tajweed, and Arabic.\",\"abt_tq1_img\":\"\",\"abt_tq2_title\":\"Tajweed Specialists\",\"abt_tq2_body\":\"Experts in rules of Tajweed with Ijazah certifications.\",\"abt_tq2_img\":\"\",\"abt_tq3_title\":\"Hifz Instructors\",\"abt_tq3_body\":\"Specialized in Quran memorization programs.\",\"abt_tq3_img\":\"\",\"abt_tq4_title\":\"Arabic Language Teachers\",\"abt_tq4_body\":\"Qualified to teach Arabic from beginner to advanced.\",\"abt_tq4_img\":\"\",\"abt_tq5_title\":\"Child-Friendly Approach\",\"abt_tq5_body\":\"Patient and engaging methods suitable for kids and teens.\",\"abt_tq5_img\":\"\",\"abt_tq6_title\":\"Female Teachers Available\",\"abt_tq6_body\":\"Qualified female teachers available for all courses.\",\"abt_tq6_img\":\"\",\"crs_hero_eyebrow\":\"OUR COURSES\",\"crs_hero_title1\":\"Learn Something Meaningful.\",\"crs_hero_title2\":\"Anywhere,\",\"crs_hero_accent\":\"Anytime.\",\"crs_hero_lead\":\"Carefully crafted online Islamic courses for all ages. Build knowledge, strengthen faith, and grow with confidence.\",\"crs_adv_title\":\"Not sure which course is right for you?\",\"crs_adv_lead\":\"Book a free trial class and our advisors will help you find the perfect course.\",\"crs_adv_btn_text\":\"Book Free Trial\",\"crs_prm_eyebrow\":\"OUR PROMISE TO YOU\",\"crs_prm_title1\":\"Education That Shapes\",\"crs_prm_title2\":\"Knowledge,\",\"crs_prm_accent\":\"Character \u0026 Future\",\"crs_prm_lead\":\"We focus on your overall growth-academically, spiritually, and personally-so you can make a positive impact in the world.\",\"crs_prm1_title\":\"Deep Understanding\",\"crs_prm1_body\":\"Gain clarity and depth in every subject you learn.\",\"crs_prm1_img\":\"\",\"crs_prm2_title\":\"Values That Guide\",\"crs_prm2_body\":\"Build strong values and character to make better choices.\",\"crs_prm2_img\":\"\",\"crs_prm3_title\":\"Skills For Real Life\",\"crs_prm3_body\":\"Develop practical skills you can use every day with confidence.\",\"crs_prm3_img\":\"\",\"crs_prm4_title\":\"Growth That Continues\",\"crs_prm4_body\":\"Keep improving your mindset, knowledge, and abilities.\",\"crs_prm4_img\":\"\",\"crs_prm5_title\":\"Positive Mindset\",\"crs_prm5_body\":\"Build resilience, focus, and a growth-oriented mind.\",\"crs_prm5_img\":\"\",\"crs_prm6_title\":\"Impact That Matters\",\"crs_prm6_body\":\"Make a difference in your family, community, and beyond.\",\"crs_prm6_img\":\"\",\"crs_out_eyebrow\":\"LEARNING OUTCOMES\",\"crs_out_title1\":\"What You Will\",\"crs_out_accent\":\"Achieve With Us\",\"crs_out_lead\":\"Our programs are thoughtfully designed to help you grow in knowledge, skills, and character-empowering you to succeed in every area of life.\",\"crs_out1_title\":\"Comprehensive Learning\",\"crs_out1_body\":\"Gain in-depth knowledge across a wide range of subjects.\",\"crs_out1_img\":\"\",\"crs_out2_title\":\"Strong Values \u0026 Character\",\"crs_out2_body\":\"Build strong values and character that guide your decisions.\",\"crs_out2_img\":\"\",\"crs_out3_title\":\"Practical Skills\",\"crs_out3_body\":\"Develop practical skills you can apply in your daily life.\",\"crs_out3_img\":\"\",\"crs_out4_title\":\"Personal Growth\",\"crs_out4_body\":\"Improve your mindset, confidence, and self-discipline.\",\"crs_out4_img\":\"\",\"crs_out5_title\":\"Positive Mindset\",\"crs_out5_body\":\"Cultivate positivity, resilience, and a growth-oriented mindset.\",\"crs_out5_img\":\"\",\"crs_out6_title\":\"Lifelong Impact\",\"crs_out6_body\":\"Create a lasting impact in your life, family, and community.\",\"crs_out6_img\":\"\",\"crs_cns_title\":\"Still Not Sure Which Course is Best for You?\",\"crs_cns_lead\":\"Get FREE COUNSELLING with our experts.\",\"crs_cns_btn_text\":\"Book Free Counselling\",\"crs_cns_image_url\":\"/images/home/quran-student.png\",\"crs_wtf_eyebrow\":\"WHO IS THIS FOR\",\"crs_wtf_title1\":\"Who Is\",\"crs_wtf_accent\":\"This For?\",\"crs_wtf_lead\":\"Our programs are created for learners at every stage of life. Wherever you are on your journey, we're here to help you grow.\",\"crs_wtf1_title\":\"Children\",\"crs_wtf1_body\":\"Help your child build strong values, good habits, and a love for learning that lasts a lifetime.\",\"crs_wtf1_img\":\"/images/home/age-kids.png\",\"crs_wtf2_title\":\"Teens\",\"crs_wtf2_body\":\"Guide your journey with knowledge, discipline, and confidence to build a bright tomorrow.\",\"crs_wtf2_img\":\"/images/home/age-teen.png\",\"crs_wtf3_title\":\"Adults\",\"crs_wtf3_body\":\"It's never too late to grow. Learn, reflect, and bring meaning and purpose to your life.\",\"crs_wtf3_img\":\"/images/home/age-adult.png\",\"crs_hlp_eyebrow\":\"We're here to help\",\"crs_hlp_title1\":\"Still Not Sure Which Course is\",\"crs_hlp_accent\":\"Best for You?\",\"crs_hlp_lead\":\"Let our academic experts guide you to the perfect course that matches your goals.\",\"crs_hlp_card_title\":\"One-to-One\",\"crs_hlp_card_sub\":\"Free Counselling\",\"crs_hlp_card_badge\":\"Available\",\"crs_hlp_btn1_text\":\"Book Free Counselling\",\"crs_hlp_btn2_text\":\"Chat With Us\",\"crs_hlp_image_url\":\"https://res.cloudinary.com/duednw9v/image/upload/v1790250882/alfurqan/settings/1790250882857_fe4274386112.webp\",\"crs_hlp_p1_title\":\"Personalized Guidance\",\"crs_hlp_p2_title\":\"Find the Right Course\",\"crs_hlp_p3_title\":\"Flexible Schedule\",\"crs_hlp_p4_title\":\"100% Free Service\",\"tch_hero_kicker\":\"MEET OUR TEACHERS\",\"tch_hero_title_line1\":\"Qualified Teachers,\",\"tch_hero_title_line2\":\"Trusted by Families Worldwide\",\"tch_hero_description\":\"Our dedicated male and female teachers are Ijazah certified and specialized in Quran, Tajweed, Hifz, Arabic and Islamic Studies. Join thousands of students in our online Quran classes and learn Quran online with the best online Quran teachers.\",\"tch_hero_stat1_title1\":\"Qualified \u0026\",\"tch_hero_stat1_title2\":\"Certified\",\"tch_hero_stat1_sub\":\"Ijazah-certified teachers\",\"tch_hero_stat2_title1\":\"Male \u0026 Female\",\"tch_hero_stat2_title2\":\"Instructors\",\"tch_hero_stat2_sub\":\"Teachers for every need\",\"tch_hero_stat3_title1\":\"1-to-1\",\"tch_hero_stat3_title2\":\"Online Classes\",\"tch_hero_stat3_sub\":\"Personalized attention\",\"tch_hero_stat4_title1\":\"Students in\",\"tch_hero_stat4_title2\":\"88+ Countries\",\"tch_hero_stat4_sub\":\"Trusted worldwide\",\"tch_feat_kicker\":\"OUR FEATURED TEACHERS\",\"tch_feat_title\":\"Featured Teachers\",\"tch_feat_lead\":\"Our qualified and experienced instructors are passionate about teaching the Quran and Arabic. They are dedicated to helping students achieve their goals with personalized guidance and care.\",\"tch_feat_a1_title\":\"Ijazah Certified\",\"tch_feat_a1_sub\":\"Qualified \u0026 trusted\",\"tch_feat_a2_title\":\"Male \u0026 Female Teachers\",\"tch_feat_a2_sub\":\"Learn with comfort\",\"tch_feat_a3_title\":\"Global Experience\",\"tch_feat_a3_sub\":\"Teaching worldwide\",\"tch_feat_a4_title\":\"Student Focused\",\"tch_feat_a4_sub\":\"Your success is our goal\",\"tch_ver_kicker\":\"OUR COMMITMENT\",\"tch_ver_title\":\"Verified Teachers\",\"tch_ver_lead\":\"At Al Furqan Academy, we are committed to providing your family with highly qualified and trustworthy teachers who deliver exceptional Arabic and Quran education.\",\"tch_ver_c1_title\":\"Certified Professionals\",\"tch_ver_c1_body\":\"Each Al Furqan teacher is a certified professional as an Arabic tutor online or an online Quran tutor, trained to teach you and your family. Our instructors have excellent command of Quran recitation and memorization and are skilled in Arabic grammar.\",\"tch_ver_c2_title\":\"Experienced \u0026 Knowledgeable\",\"tch_ver_c2_body\":\"Besides being qualified professionals, our teachers bring valuable experience in teaching Arabic language, Fiqh (Islamic jurisprudence), Tafseer, Tajweed, and Islamic history.\",\"tch_ver_c3_title\":\"Female Teacher Option\",\"tch_ver_c3_body\":\"We also offer the option of an online female Quran teacher to address those needs. Our tutors are trained to handle children ages 5 to 15, and create a welcoming online learning environment to best suit your family's need.\",\"tch_ver_h1_title\":\"Rigorous Hiring Process\",\"tch_ver_h1_body\":\"Our tutor hiring process is rigorous. Each candidate must go through a round of interviews and a verification process.\",\"tch_ver_h2_title\":\"Thorough Background Check\",\"tch_ver_h2_body\":\"All candidates are required to complete a full background check. This process guarantees that only the best are selected to instruct families throughout their Arabic and Quran learning journey.\",\"tch_ver_h3_title\":\"Ongoing Evaluation \u0026 Quality Assurance\",\"tch_ver_h3_body\":\"To ensure that our instructors are always delivering high-quality teaching, they must participate in regular evaluations to verify that their knowledge and skills still consistently meets our standards.\",\"tch_ver_cta_title\":\"Start Your Child's Learning Journey\",\"tch_ver_cta_body\":\"Join thousands of families who trust our verified teachers to provide the best learning experience.\",\"tch_qual_title\":\"Quality teachers.\",\"tch_qual_subtitle\":\"Better learning.\",\"tch_qual_body\":\"Only verified and experienced teachers for your family's learning journey.\",\"tch_inst_kicker\":\"Our promise to your success\",\"tch_inst_title_line1\":\"Outstanding\",\"tch_inst_title_line2\":\"Instruction\",\"tch_inst_subtitle\":\"DESIGNED TO HELP STUDENTS SUCCEED\",\"tch_inst_body\":\"At Al Furqan Academy, we combine expert teaching with innovative technology to create an engaging and effective learning experience. Our Arabic and Quran programs are designed to support every student's journey from the comfort of home.\",\"tch_inst_image_url\":\"/images/home/blog-featured.png\",\"tch_inst_p1_title\":\"24/7 Tutor Support\",\"tch_inst_p1_body\":\"We are available anytime to support you and your child.\",\"tch_inst_p2_title\":\"One-to-One|Sessions\",\"tch_inst_p2_body\":\"Personalized attention for faster and better understanding.\",\"tch_inst_p3_title\":\"Expert-Curated|Curriculum\",\"tch_inst_p3_body\":\"Structured courses designed by Arabic and Quran experts.\",\"tch_inst_p4_title\":\"Safe \u0026 Interactive|Platform\",\"tch_inst_p4_body\":\"A secure environment for focused and distraction-free learning.\",\"tch_inst_h1_title\":\"Highly Qualified Teachers\",\"tch_inst_h1_body\":\"Experienced, certified, and passionate about teaching.\",\"tch_inst_h2_title\":\"Live Interactive Classes\",\"tch_inst_h2_body\":\"Real-time sessions with instant feedback for better learning.\",\"tch_inst_h3_title\":\"Personalized Learning\",\"tch_inst_h3_body\":\"Customized lessons that match each student's level and goals.\",\"tch_inst_h4_title\":\"Flexible \u0026 Convenient\",\"tch_inst_h4_body\":\"Choose timings that fit your schedule. Learn from anywhere.\",\"tch_inst_pr1_title\":\"Global Learning\",\"tch_inst_pr1_body\":\"Students from 80+ countries trust our teaching.\",\"tch_inst_pr2_title\":\"Thousands of Students\",\"tch_inst_pr2_body\":\"Join thousands of learners achieving their goals.\",\"tch_inst_pr3_title\":\"Proven Track Record\",\"tch_inst_pr3_body\":\"Helping students build strong Quran and Arabic skills.\",\"tch_inst_pr4_title\":\"Faith. Knowledge. Character.\",\"tch_inst_pr4_body\":\"We focus on developing not just skills, but better Muslims.\",\"loader_image_url\":\"https://res.cloudinary.com/duednw9v/image/upload/v1789322192/alfurqan/general/1789322191313_18e6674e2808.png\",\"loader_tag\":\"Al Furqan Academy\",\"loader_message\":\"Loading experience\",\"footer_whatsapp_title\":\"Say Salam to Al Furqan on WhatsApp\",\"footer_email_title\":\"Email us anytime at\",\"footer_newsletter_title\":\"Subscribe to our newsletter\",\"footer_newsletter_subtitle\":\"Get updates on new courses and offers.\",\"footer_newsletter_placeholder\":\"Your email address\",\"footer_app_title\":\"Download our App\",\"footer_learn_title\":\"Learn from anywhere\",\"footer_learn_description\":\"Join students from around the world and learn from the comfort of your home.\",\"footer_countries_title\":\"Online Quran classes in\",\"footer_legal_terms_label\":\"Terms of Service\",\"footer_legal_terms_link\":\"/terms\",\"footer_legal_privacy_label\":\"Privacy Policy\",\"footer_legal_privacy_link\":\"/privacy-policy\",\"footer_legal_cookie_label\":\"Cookie Policy\",\"footer_legal_cookie_link\":\"/cookie-policy\",\"footer_legal_sitemap_label\":\"Sitemap\",\"footer_legal_sitemap_link\":\"/sitemap\",\"footer_contact_enabled\":true,\"footer_newsletter_enabled\":true,\"footer_app_enabled\":true,\"footer_learn_enabled\":true,\"footer_address_enabled\":true,\"footer_legal_enabled\":true,\"footer_social_links\":[{\"id\":\"wa\",\"url\":\"https://wa.me/442045771227\",\"label\":\"WhatsApp\",\"visible\":true,\"platform\":\"whatsapp\"},{\"id\":\"x\",\"url\":\"https://x.com/alfurqan\",\"label\":\"X\",\"visible\":true,\"platform\":\"x\"},{\"id\":\"fb\",\"url\":\"\",\"label\":\"Facebook\",\"visible\":false,\"platform\":\"facebook\"},{\"id\":\"ig\",\"url\":\"\",\"label\":\"Instagram\",\"visible\":false,\"platform\":\"instagram\"},{\"id\":\"yt\",\"url\":\"\",\"label\":\"YouTube\",\"visible\":false,\"platform\":\"youtube\"}],\"header_scripts\":\"\u003c!-- Google Tag Manager --\u003e\\n\u003cscript\u003e(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':\\nnew Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],\\nj=d.createElement(s),dl=l!='dataLayer'?'\u0026l='+l:'';j.async=true;j.src=\\n'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);\\n})(window,document,'script','dataLayer','GTM-PDRK96R');\u003c/script\u003e\\n\u003c!-- End Google Tag Manager --\u003e\\n\\n\u003c!-- Google tag (gtag.js) --\u003e\\n\u003cscript async src=\\\"https://www.googletagmanager.com/gtag/js?id=G-CNRH4K74ZC\\\"\u003e\u003c/script\u003e\\n\u003cscript\u003e\\n  window.dataLayer = window.dataLayer || [];\\n  function gtag(){dataLayer.push(arguments);}\\n  gtag('js', new Date());\\n\\n  gtag('config', 'G-CNRH4K74ZC');\\n\u003c/script\u003e\\n\\n\\n\u003c!-- Google tag (gtag.js) --\u003e\\n\u003cscript async src=\\\"https://www.googletagmanager.com/gtag/js?id=G-VZ40SDM0VW\\\"\u003e\u003c/script\u003e\\n\u003cscript\u003e\\n  window.dataLayer = window.dataLayer || [];\\n  function gtag(){dataLayer.push(arguments);}\\n  gtag('js', new Date());\\n\\n  gtag('config', 'G-VZ40SDM0VW');\\n\u003c/script\u003e\",\"body_start_scripts\":\"\u003c!-- Google Tag Manager (noscript) --\u003e\\n\u003cnoscript\u003e\u003ciframe src=\\\"https://www.googletagmanager.com/ns.html?id=GTM-PDRK96R\\\"\\nheight=\\\"0\\\" width=\\\"0\\\" style=\\\"display:none;visibility:hidden\\\"\u003e\u003c/iframe\u003e\u003c/noscript\u003e\\n\u003c!-- End Google Tag Manager (noscript) --\u003e\",\"footer_scripts\":\"\",\"chat_widget_enabled\":true,\"chat_floating_pill_text\":\"Need Help? Ask Al Furqan Ai\",\"chat_floating_icon\":\"💬\",\"chat_header_title\":\"Al Furqan AI\",\"chat_header_badge\":\"24/7 Live\",\"chat_header_subtitle\":\"Instant Islamic Studies \u0026 Admissions Advisor\",\"chat_header_avatar\":\"🤖\",\"chat_consultation_title\":\"Start Your AI Consultation\",\"chat_consultation_subtitle\":\"Enter details to connect with your Admissions Advisor\",\"chat_consultation_icon\":\"🌙\",\"chat_bot_avatar\":\"🤖\",\"chat_welcome_message\":\"Assalamu Alaikum! Welcome to **Al Furqan Academy 🌙\\n\\nI am your 24/7 Ai Academic Advisor. How can I assist you with Quran, Tajweed, or Arabic studies today?\",\"chat_welcome_actions\":[{\"id\":\"act-1\",\"url\":\"/register\",\"icon\":\"📅\",\"label\":\"Book Free Trial (30 Min)\",\"active\":true,\"isExternal\":false},{\"id\":\"act-2\",\"url\":\"/pricing\",\"icon\":\"💰\",\"label\":\"View Pricing Plans\",\"active\":true,\"isExternal\":false},{\"id\":\"act-3\",\"url\":\"https://wa.me/442045771227\",\"icon\":\"💬\",\"label\":\"WhatsApp Support\",\"active\":true,\"isExternal\":true}],\"chat_starter_chips\":[{\"id\":\"chip-1\",\"label\":\"Book a Free Trial Class\",\"active\":true,\"prompt\":\"How can I book a free trial class?\",\"actions\":[{\"id\":\"c1-a1\",\"url\":\"/register\",\"icon\":\"📅\",\"label\":\"Book Free Trial (30 Min)\",\"active\":true,\"isExternal\":false},{\"id\":\"c1-a2\",\"url\":\"https://wa.me/442045771227\",\"icon\":\"💬\",\"label\":\"WhatsApp Assistant\",\"active\":true,\"isExternal\":true}],\"response\":\"The trial is free, 30 minutes, and no card is needed. You pick a day and time, tell us the course, and say whether you'd prefer a male or female teacher. The teacher checks where the student is at and builds a plan from there.\",\"followUpChips\":[\"What are your monthly fees?\",\"Do you have female teachers?\",\"How do 1-on-1 classes work?\"]},{\"id\":\"chip-2\",\"label\":\"What are your monthly fees?\",\"active\":true,\"prompt\":\"What are your monthly course fees and pricing plans?\",\"actions\":[{\"id\":\"c2-a1\",\"url\":\"/pricing\",\"icon\":\"💰\",\"label\":\"View Detailed Pricing\",\"active\":true,\"isExternal\":false},{\"id\":\"c2-a2\",\"url\":\"/register\",\"icon\":\"📅\",\"label\":\"Book Free Trial Class\",\"active\":true,\"isExternal\":false}],\"response\":\"We offer flexible monthly plans for private one-to-one classes. There's a family discount for 2+ students, and the first class is free.\\nClick the button below to view our plans and fees.\",\"followUpChips\":[\"Book a Free Trial Class\",\"Family discount details\",\"Do you have female teachers?\"]},{\"id\":\"chip-3\",\"label\":\"Do you have female teachers?\",\"active\":true,\"prompt\":\"Do you have certified female teachers for sisters and kids?\",\"actions\":[{\"id\":\"c3-a1\",\"url\":\"/register\",\"icon\":\"👩‍🏫\",\"label\":\"Request Female Teacher\",\"active\":true,\"isExternal\":false},{\"id\":\"c3-a2\",\"url\":\"https://wa.me/442045771227\",\"icon\":\"💬\",\"label\":\"Chat on WhatsApp\",\"active\":true,\"isExternal\":true}],\"response\":\"Yes - we have certified female teachers for sisters, girls and young children. They're Al-Azhar graduates with Tajweed Ijazah and speak English, Arabic and Urdu.\",\"followUpChips\":[\"Book a Free Trial Class\",\"Classes for kids\",\"What are your monthly fees?\"]},{\"id\":\"chip-4\",\"label\":\"Classes for kids\",\"active\":true,\"prompt\":\"Tell me about classes for young kids\",\"actions\":[{\"id\":\"c4-a1\",\"url\":\"/register\",\"icon\":\"👶\",\"label\":\"Book Free Evaluation for Kids\",\"active\":true,\"isExternal\":false},{\"id\":\"c4-a2\",\"url\":\"/pricing\",\"icon\":\"👨‍👩‍👧‍👦\",\"label\":\"Family Package Pricing\",\"active\":true,\"isExternal\":false}],\"response\":\"We take students from 4 years old. For the little ones the teachers use a digital Qaida board and games to keep it fun, and you get a monthly progress report.\",\"followUpChips\":[\"Book a Free Trial Class\",\"Do you have female teachers?\",\"What are your monthly fees?\"]},{\"id\":\"chip-5\",\"label\":\"How do 1-on-1 classes work?\",\"active\":true,\"prompt\":\"How do 1-on-1 online classes work?\",\"actions\":[{\"id\":\"c5-a1\",\"url\":\"/register\",\"icon\":\"🎓\",\"label\":\"Experience Free 30-Min Class\",\"active\":true,\"isExternal\":false},{\"id\":\"c5-a2\",\"url\":\"/courses\",\"icon\":\"📖\",\"label\":\"View All Courses\",\"active\":true,\"isExternal\":false}],\"response\":\"It's a live one-to-one video call, usually Zoom/MS Teams/GMeet. The teacher shares a digital Quran on screen with Tajweed rules colour-coded, and corrects pronunciation as you read. Reschedule free with 4 hours notice.\",\"followUpChips\":[\"Book a Free Trial Class\",\"What are your monthly fees?\",\"WhatsApp Support\"]},{\"id\":\"chip-6\",\"label\":\"WhatsApp Support\",\"active\":true,\"prompt\":\"I want to chat on WhatsApp with an admissions advisor\",\"actions\":[{\"id\":\"c6-a1\",\"url\":\"https://wa.me/442045771227\",\"icon\":\"💬\",\"label\":\"Open WhatsApp Chat (+44 20 4577 1227)\",\"active\":true,\"isExternal\":true},{\"id\":\"c6-a2\",\"url\":\"/register\",\"icon\":\"📅\",\"label\":\"Book Free Trial Online\",\"active\":true,\"isExternal\":false}],\"response\":\"Our admissions team is on WhatsApp and usually replies quickly - they can sort scheduling or enrolment directly.\",\"followUpChips\":[\"Book a Free Trial Class\",\"What are your monthly fees?\",\"Do you have female teachers?\"]}],\"chat_predefined_qa\":[{\"id\":\"qa-1\",\"active\":true,\"answer\":\"The first class is free - 30 minutes, no card needed. Pick a slot that suits you and the teacher will assess the level and plan from there.\",\"actions\":[{\"id\":\"qa1-a1\",\"url\":\"/register\",\"icon\":\"📅\",\"label\":\"Book Free Trial Class Now\",\"active\":true,\"isExternal\":false},{\"id\":\"qa1-a2\",\"url\":\"https://wa.me/442045771227\",\"icon\":\"💬\",\"label\":\"WhatsApp Assistant\",\"active\":true,\"isExternal\":true}],\"keywords\":[\"trial\",\"free\",\"demo\",\"book\",\"register\",\"test class\",\"evaluation\"],\"question\":\"Free Trial Class Booking\",\"followUpChips\":[\"Pick Date \u0026 Time for Trial\",\"What are your course fees?\",\"Female teacher available?\",\"What app do we use for class?\"]},{\"id\":\"qa-2\",\"active\":true,\"answer\":\"Plans start at $35/month for 2 classes a week and go up to $80 for 5, all one-to-one. Family discount for 2+ students, and the first class is free.\",\"actions\":[{\"id\":\"qa2-a1\",\"url\":\"/pricing\",\"icon\":\"💰\",\"label\":\"View Detailed Pricing\",\"active\":true,\"isExternal\":false},{\"id\":\"qa2-a2\",\"url\":\"/register\",\"icon\":\"📅\",\"label\":\"Book Free Trial Class\",\"active\":true,\"isExternal\":false}],\"keywords\":[\"price\",\"cost\",\"fee\",\"fees\",\"package\",\"monthly\",\"kitna\",\"kitne\",\"rate\",\"charge\",\"dollar\",\"gbp\",\"aed\",\"discount\"],\"question\":\"Course Fees \u0026 Pricing Plans\",\"followUpChips\":[\"Book Free Trial Class\",\"Family discount details\",\"Are teachers female?\",\"How do I reschedule?\"]},{\"id\":\"qa-3\",\"active\":true,\"answer\":\"Yes, we have certified female teachers (Ustadhas) for sisters, girls and young children — all Al-Azhar graduates with Tajweed Ijazah.\",\"actions\":[{\"id\":\"qa3-a1\",\"url\":\"/register\",\"icon\":\"👩‍🏫\",\"label\":\"Request Female Teacher\",\"active\":true,\"isExternal\":false},{\"id\":\"qa3-a2\",\"url\":\"/courses\",\"icon\":\"🎓\",\"label\":\"Meet Our Teachers\",\"active\":true,\"isExternal\":false}],\"keywords\":[\"female\",\"woman\",\"women\",\"lady\",\"sister\",\"ladki\",\"aurat\",\"ustadha\",\"female teacher\"],\"question\":\"Female Teachers \u0026 Tutors\",\"followUpChips\":[\"Book trial with female teacher\",\"Classes for 5-year-old child\",\"What are the fees?\",\"What is the class schedule?\"]},{\"id\":\"qa-4\",\"active\":true,\"answer\":\"We teach from 4 years old upwards. Young children get teachers who specialise in that age group, with short visual lessons and a monthly progress report.\",\"actions\":[{\"id\":\"qa4-a1\",\"url\":\"/register\",\"icon\":\"👶\",\"label\":\"Book Free Evaluation for Kids\",\"active\":true,\"isExternal\":false},{\"id\":\"qa4-a2\",\"url\":\"/pricing\",\"icon\":\"👨‍👩‍👧‍👦\",\"label\":\"Family Discount Info\",\"active\":true,\"isExternal\":false}],\"keywords\":[\"kid\",\"child\",\"children\",\"bache\",\"bacha\",\"bacho\",\"age\",\"years old\",\"umar\",\"son\",\"daughter\"],\"question\":\"Classes for Children \u0026 Kids\",\"followUpChips\":[\"Book trial for my child\",\"Start Noorani Qaida basics\",\"Family discount details\",\"What are your timings?\"]},{\"id\":\"qa-5\",\"active\":true,\"answer\":\"We run 24/7, so you choose the days and times — any timezone, weekends included. If a class is missed, tell us 4 hours ahead and we'll reschedule it free.\",\"actions\":[{\"id\":\"qa5-a1\",\"url\":\"/register\",\"icon\":\"⏰\",\"label\":\"Pick Your Time Slot\",\"active\":true,\"isExternal\":false},{\"id\":\"qa5-a2\",\"url\":\"https://wa.me/442045771227\",\"icon\":\"💬\",\"label\":\"WhatsApp Support\",\"active\":true,\"isExternal\":true}],\"keywords\":[\"time\",\"timing\",\"schedule\",\"slot\",\"waqt\",\"kab\",\"weekend\",\"reschedule\",\"timezone\",\"miss\",\"cancel\"],\"question\":\"Class Timings \u0026 24/7 Scheduling\",\"followUpChips\":[\"Book trial slot\",\"What are your monthly fees?\",\"Do you have female tutors?\"]}],\"chat_interest_options\":[\"Quran with Tajweed\",\"Quran Reading (Qaida)\",\"Hifz Memorization\",\"Arabic Language\",\"Islamic Studies\",\"Fees \u0026 Pricing\"],\"chat_enabled_locales\":[\"en\",\"hinglish\",\"ur\",\"ar\",\"fr\",\"id\"],\"home_course_cards\":[{\"blurb\":\"\u003cp class=\\\"MsoNormal\\\"\u003e\u003cspan lang=\\\"EN-US\\\"\u003eLearn to read and recite the Holy Quran\\nwith Tajweed and correct Makharij through structured online Quran classes\\nfor beginners and learners of all ages.\u003co:p\u003e\u003c/o:p\u003e\u003c/span\u003e\u003c/p\u003e\",\"image\":\"https://res.cloudinary.com/duednw9v/image/upload/v1791035569/alfurqan/home/1791035569204_54c8df2eb63b.webp\",\"items\":[\"Quran with Tajweed\",\"Quran Memorization\",\"Noorani Qaida\",\"Quranic Arabic\"],\"title\":\"Quran Learning\",\"enabled\":true},{\"blurb\":\"\u003cp class=\\\"MsoNormal\\\"\u003e\u003cspan lang=\\\"EN-US\\\"\u003eLearn essential Islamic knowledge including\\nAqeedah, Fiqh, Seerah, Duas, and Islamic manners through structured online\\nclasses.\u003co:p\u003e\u003c/o:p\u003e\u003c/span\u003e\u003c/p\u003e\",\"image\":\"https://res.cloudinary.com/duednw9v/image/upload/v1791036052/alfurqan/home/1791036052015_a92f1d6059b3.webp\",\"items\":[\"Islamic Foundations\",\"Akhlaaq (Islamic Manners)\",\"Fiqh (Islamic Jurisprudence)\",\"Seerah (Life of the Prophet ﷺ)\"],\"title\":\"Islamic Studies\",\"enabled\":true},{\"blurb\":\"\u003cp\u003e\u003cspan lang=\\\"EN-US\\\" style=\\\"line-height: 115%;\\\"\u003eLearn\\nArabic online for everyday conversations, academics, school studies, and\\nprofessional growth - with confidence and fluency\u003c/span\u003e\u003c/p\u003e\",\"image\":\"https://res.cloudinary.com/duednw9v/image/upload/v1791037160/alfurqan/home/1791037159509_69e88dea6e48.webp\",\"items\":[\"Spoken Arabic Language\",\"School Arabic\",\"Professional Arabic\",\"Arabic Grammar (Nahw \u0026 Sarf)\"],\"title\":\"Arabic Language\",\"enabled\":true}],\"home_teacher_cards\":[{\"name\":\"Eptehal Elgendy\",\"role\":\"Quran, Arabic \u0026 Islamic Studies Teacher\",\"photo\":\"https://res.cloudinary.com/duednw9v/image/upload/v1791203639/alfurqan/home/1791203638695_8302c516f7fb.webp\",\"points\":[\"4+ Years of Teaching Experience\",\"Dentist \u0026 Arabic Language Tutor\",\"Quran \u0026 Arabic Specialist\",\"Multiple Quranic Ijazat\",\"Expert in Child-Friendly Learning\"],\"enabled\":true},{\"name\":\"Merna Hossam Eldin\",\"role\":\"Quran, Arabic \u0026 Islamic Studies Teacher\",\"photo\":\"https://res.cloudinary.com/duednw9v/image/upload/v1791203646/alfurqan/home/1791203646805_b02b1544fbf5.webp\",\"points\":[\"6+ Years of Teaching Experience\",\"Expert in Arabic \u0026 Quran\",\"Specialist in Non-Arabic Speakers\",\"Islamic Studies Educator\",\"Personalized \u0026 Student-Centered Learning\"],\"enabled\":true},{\"name\":\"Hassan Ibrahim\",\"role\":\"Quran Teacher\",\"photo\":\"https://res.cloudinary.com/duednw9v/image/upload/v1791205474/alfurqan/home/1791205474352_d4eac6ad3762.webp\",\"points\":[\"7+ Years of Quran Teaching Experience\",\"Hafiz of the Holy Quran\",\"Ijazah in 7 Qira’at\",\"Al-Azhar Al-Sharif Ijazah\",\"Expert in Tajweed \u0026 Quran Recitation\"],\"enabled\":true},{\"name\":\"Sayed Ahmed\",\"role\":\"Quran, Arabic \u0026 Islamic Studies Teacher\",\"photo\":\"https://res.cloudinary.com/duednw9v/image/upload/v1791205202/alfurqan/home/1791205202325_9abfae6bfa99.webp\",\"points\":[\"Al-Azhar University Graduate\",\"Ijazah in Hafs 'an 'Asim\",\"Expert in Quran \u0026 Tajweed\",\"Specialist in Arabic \u0026 Islamic Studies\",\"Experienced in Teaching Non-Native Speakers\"],\"enabled\":true}],\"lead_notification_emails\":[\"imran.gauri@gmail.com\",\"rafat@alfurqan.academy\",\"Imran@alfurqan.academy\",\"riyaz@alfurqan.academy\"],\"course_slug_redirects\":{\"juz-amma\":\"arabic-for-school-students\",\"quran-reading\":\"tajweed-masterclass\",\"spoken-arabic\":\"20-short-surahs-memorization\",\"seerah-studies\":\"seerah-of-prophet-muhammad\",\"quran-readingdddd\":\"tajweed-masterclass\",\"quran-with-tajweed\":\"quran-memorization\",\"tajweedmasterclass\":\"tajweed-masterclass\",\"quran-with-tajweeddfasdf\":\"quran-memorization\"}},\"navigation\":{\"header\":[{\"id\":\"b420a8ca-9e34-4904-84aa-ff80a0b0172c\",\"label\":\"Courses\",\"href\":\"/courses\",\"newTab\":false,\"badge\":null,\"showChevron\":false,\"children\":[]},{\"id\":\"8ad6a82b-a342-435c-820d-eba1c0c5f0d8\",\"label\":\"Pricing\",\"href\":\"/pricing\",\"newTab\":false,\"badge\":null,\"showChevron\":false,\"children\":[]},{\"id\":\"48560efe-3c28-4d97-90f1-0d53cec26bd8\",\"label\":\"TEACHERS\",\"href\":\"/teachers\",\"newTab\":false,\"badge\":null,\"showChevron\":false,\"children\":[]},{\"id\":\"0ddecaa